# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.spec
# La receta de empaquetado sí se versiona: sin esta excepción, la build no es
# reproducible desde un clon limpio.
!packaging/*.spec
.build-tools/

# Virtual environments
.venv/
venv/
# El entorno de build de Windows lo crea build.ps1
.venv-win/

# IDE
.vscode/
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Project specific
*.deb
*.rpm
*.AppImage
*.tar.gz
*.jar
*.pkg
*.b64
logs/
.env
.ruff_cache/
# Instaladores y payloads de Windows
*.exe
# El .ico se genera en el build desde icon-256.png, para no versionar un
# derivado que puede quedar desincronizado con el original.
assets/icon.ico

# Estado de la herramienta de desarrollo
.freebuff/

# VS Code
.vscode/

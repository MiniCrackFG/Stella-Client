#!/bin/sh
# Punto de entrada del AppImage.
#
# Reutiliza el mismo lanzador que las instalaciones nativas (.deb y .rpm) para
# que las tres formas de instalar arranquen exactamente igual: si algún día hace
# falta preparar el entorno antes del exec, se toca en un solo sitio.
#
# El directorio se deduce de `$0` en vez de fiarse de `$APPDIR`. Dos motivos:
#
# - `$APPDIR` lo define el runtime del AppImage, pero no existe si alguien
#   ejecuta el AppRun de un AppDir extraído, que es justo como se verifica esto.
# - `$APPDIR` puede venir heredado del entorno de fuera (por ejemplo si el
#   launcher se lanza desde otra aplicación que también es un AppImage) y
#   apuntaría a un directorio ajeno.
#
# `$0` siempre es `<punto de montaje>/AppRun`, así que sirve en los dos casos.
set -e

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
runner="$here/usr/lib/stella-client/stella-client-run"

if [ ! -x "$runner" ] && [ -n "${APPDIR:-}" ]; then
    runner="$APPDIR/usr/lib/stella-client/stella-client-run"
fi

exec "$runner" "$@"
